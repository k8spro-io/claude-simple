{
  "//": "simple: command allowances for the php stack. Merged into .claude/settings.json by /simple:setup when this stack is detected.",
  "permissions": {
    "allow": [
      "Bash(composer install)",
      "Bash(composer show:*)",
      "Bash(composer test:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(php artisan test:*)",
      "Bash(php artisan route:list)",
      "Bash(php -v)"
    ]
  }
}
