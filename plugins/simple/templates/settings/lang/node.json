{
  "//": "simple: command allowances for the node stack. Merged into .claude/settings.json by /simple:setup when this stack is detected.",
  "permissions": {
    "allow": [
      "Bash(bun run:*)",
      "Bash(bun install)",
      "Bash(bun test:*)",
      "Bash(bun x tsc:*)",
      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm test:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(yarn install)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
