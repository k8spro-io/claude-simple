{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "Recommended project settings installed by /simple:setup. Merged key by key — anything you already have is kept. Language-specific command allowances come from templates/settings/lang/*.json, added only for the stacks detected in this repo. Read docs/permissions.md before changing the lists: deny ALWAYS beats allow, and a Read() deny also blocks Edit and Write on the same path.",
  "env": {
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "4"
  },
  "skillListingMaxDescChars": 600,
  "autoCompactWindow": 300000,
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "claudeMdExcludes": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/.claude/worktrees/**"
  ],
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(rm -rf /bin*)",
      "Bash(rm -rf /boot*)",
      "Bash(rm -rf /dev*)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -rf /lib*)",
      "Bash(rm -rf /lib64*)",
      "Bash(rm -rf /opt*)",
      "Bash(rm -rf /proc*)",
      "Bash(rm -rf /root*)",
      "Bash(rm -rf /run*)",
      "Bash(rm -rf /sbin*)",
      "Bash(rm -rf /srv*)",
      "Bash(rm -rf /sys*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf /var*)",
      "Bash(rm -rf /home)",
      "Bash(rm -rf /home/)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ..*)",
      "Bash(sudo rm*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git clean *)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(kubectl delete pvc*)",
      "Bash(kubectl delete pv *)",
      "Bash(kubectl delete namespace*)",
      "Bash(kubectl delete ns *)",
      "Bash(kubectl delete secret*)",
      "Bash(terraform destroy*)",
      "Bash(pulumi destroy*)",
      "Bash(npm publish*)",
      "Bash(bun publish*)",
      "Bash(cargo publish*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/.git/**)",
      "Read(**/.nuxt/**)",
      "Read(**/.output/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/coverage/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.terraform/**)",
      "Read(**/.claude/worktrees/**)",
      "Read(**/go.sum)",
      "Read(**/bun.lock)",
      "Read(**/bun.lockb)",
      "Read(**/package-lock.json)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/target/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/.gradle/**)",
      "Read(**/.dart_tool/**)",
      "Read(**/Pods/**)",
      "Read(**/DerivedData/**)",
      "Read(**/zig-cache/**)",
      "Read(**/.zig-cache/**)",
      "Read(**/_build/**)",
      "Read(**/deps/**)",
      "Read(**/.bundle/**)",
      "Read(**/site-packages/**)",
      "Read(**/Cargo.lock)",
      "Read(**/composer.lock)",
      "Read(**/Gemfile.lock)",
      "Read(**/poetry.lock)",
      "Read(**/uv.lock)",
      "Read(**/yarn.lock)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_ed25519*)"
    ],
    "allow": [
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(sed -n:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git worktree list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl config get-contexts)"
    ]
  }
}
