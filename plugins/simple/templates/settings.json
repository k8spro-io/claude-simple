{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "//": "Recommended project settings installed by /simple:setup. Merged key by key — anything you already have is kept. Read plugins/simple/docs/permissions.md before changing the lists: deny ALWAYS beats allow, and a Read() deny also blocks Edit and Write on the same path.",

  "env": {
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "4"
  },

  "skillListingMaxDescChars": 600,
  "autoCompactWindow": 300000,

  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },

  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },

  "claudeMdExcludes": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/.claude/worktrees/**"
  ],

  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ..*)",
      "Bash(sudo rm*)",

      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git clean *)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",

      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",

      "Bash(kubectl delete pvc*)",
      "Bash(kubectl delete pv *)",
      "Bash(kubectl delete namespace*)",
      "Bash(kubectl delete ns *)",
      "Bash(kubectl delete secret*)",
      "Bash(terraform destroy*)",
      "Bash(pulumi destroy*)",

      "Bash(npm publish*)",
      "Bash(bun publish*)",
      "Bash(cargo publish*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",

      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/.git/**)",
      "Read(**/.nuxt/**)",
      "Read(**/.output/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/coverage/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.terraform/**)",
      "Read(**/.claude/worktrees/**)",
      "Read(**/go.sum)",
      "Read(**/bun.lock)",
      "Read(**/bun.lockb)",
      "Read(**/package-lock.json)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)"
    ],
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go env:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go mod why:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint run:*)",

      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run test)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(task test:*)",
      "Bash(task --list*)",
      "Bash(make test*)",

      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(sed -n:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git worktree list:*)",

      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",

      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl config get-contexts)"
    ]
  }
}
